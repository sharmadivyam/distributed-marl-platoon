# environment and caches
.venv/
__pycache__/
*.pyc
.DS_Store

# bulky experiment outputs (regenerate with the scripts in demo/ and mpi/)
demo/runs_*/
demo/videos/
demo/results_*/
mpi/logs/
mpi/results/logs/

# from demo/runs keep only what the simulator and MPI demo need: configs + best checkpoints
demo/runs/**
!demo/runs/**/
!demo/runs/*/data/*.ini
!demo/runs/*/model/best/*.pt

# from demo/repro and mpi/train keep configs + learning curves, and the NeurComm model MPI uses
demo/repro/**
!demo/repro/**/
!demo/repro/*/*/data/*.ini
!demo/repro/*/*/data/train_reward.csv
!demo/repro/nc_alpha0.9_seed13/ma2c_nc_catchup/model/best/*.pt
mpi/train/**
!mpi/train/**/
!mpi/train/**/data/*.ini
!mpi/train/**/data/train_log.jsonl
